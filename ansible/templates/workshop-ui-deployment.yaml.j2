apiVersion: apps/v1
kind: Deployment
metadata:
  name: workshop-ui
  namespace: "{{ workshop_ui_namespace }}"
  labels:
    app: workshop-ui
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: workshop-ui
  template:
    metadata:
      labels:
        app: workshop-ui
    spec:
      initContainers:
        - name: git-cloner
          image: "{{ git_cloner_image }}"
          env:
            - name: GIT_REPO_URL
              value: "{{ content_git_repo_url }}"
            - name: GIT_REPO_REF
              value: "{{ content_git_repo_ref }}"
            - name: CLONE_DIR
              value: /content/repo
          volumeMounts:
            - name: content
              mountPath: /content
      containers:
        - name: workshop-ui
          image: "{{ workshop_ui_image }}"
          command: ["/bin/sh", "-c"]
          args:
            - cd /content/repo/workshop-ui && pip install --user -q -r requirements.txt && exec python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8080
          env:
            - name: DATABASE_PATH
              value: /data/workshop.db
            - name: ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: workshop-ui-secret
                  key: ADMIN_PASSWORD
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: workshop-ui-secret
                  key: SECRET_KEY
          ports:
            - name: http
              containerPort: 8080
          volumeMounts:
            - name: content
              mountPath: /content
            - name: data
              mountPath: /data
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 20
            periodSeconds: 20
      volumes:
        - name: content
          emptyDir: {}
        - name: data
          persistentVolumeClaim:
            claimName: workshop-ui-data
